# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database URI (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/mess_management
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mess_management
MONGODB_URI=mongodb://127.0.0.1:27017/mess_management

# JWT Authentication Secret & Expiration
JWT_SECRET=mess_management_super_secret_jwt_key_2026
JWT_EXPIRES_IN=30d

# Admin Registration Protection Key
ADMIN_REGISTRATION_SECRET=ADMIN_MESS_KEY_2026
